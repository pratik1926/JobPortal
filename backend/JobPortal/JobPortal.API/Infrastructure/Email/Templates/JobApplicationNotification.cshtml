<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #222;
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
        }

        .header {
            background: #0b5ed7;
            color: white;
            padding: 12px;
            border-radius: 6px 6px 0 0;
        }

        .content {
            border: 1px solid #eaeaea;
            padding: 20px;
            border-top: none;
            border-radius: 0 0 6px 6px;
        }

        .meta {
            font-size: 14px;
            color: #555;
            margin-bottom: 12px;
        }

        .cover {
            white-space: pre-wrap;
            background: #f8f9fa;
            padding: 12px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>New application: @Model.JobTitle</h2>
        </div>
        <div class="content">
            <p class="meta"><strong>Applicant:</strong> @Model.SeekerName (@Model.SeekerEmail)</p>
            @if (!string.IsNullOrEmpty((string?)Model.ProfileSummary))
            {
                <p class="meta"><strong>Profile:</strong> @Model.ProfileSummary</p>
            }
            <p class="meta"><strong>Applied At (UTC):</strong> @Model.AppliedAtUtc</p>

            <h4>Cover Letter</h4>
            <div class="cover">@Model.CoverLetter ?? "&mdash;"</div>

            <p>Resume is attached to this email for your review.</p>

            <hr />
            <p style="font-size:12px; color:#777">Sent by Job Portal</p>
        </div>
    </div>
</body>
</html>